{
  "name": "canventura-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build",
    "seo:check": "node scripts/check-seo.mjs",
    "validate": "npm run build && npm run seo:check",
    "performance:report": "npm run build && node scripts/report-performance.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "lighthouse": "12.8.2",
    "wrangler": "^4.0.0"
  }
}
