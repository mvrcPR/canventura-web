---
import Home from "../../components/Home.astro";
import { locales, type Locale } from "../../content/site";
export const prerender = true;
export function getStaticPaths() {
  return locales
    .filter((lang) => lang !== "ca")
    .map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
---

<Home locale={locale} />
