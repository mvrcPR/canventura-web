---
import logo from "../../public/brand/can-ventura-logo.svg?raw";
import {
  copy,
  locales,
  homePath,
  menuPath,
  pagePath,
  reservationUrl,
  languageNames,
  type Locale,
  type Page,
} from "../content/site";
interface Props {
  locale: Locale;
  page?: Page;
}
const { locale, page = "home" } = Astro.props;
const t = copy[locale];
---

<header class="site-header" data-page={page}>
  <a
    class="brand"
    href={homePath(locale)}
    aria-label={`Can Ventura · ${t.home}`}
    set:html={logo}
  />
  <nav class="primary-nav mono" aria-label={t.navigation}>
    <a href={`${homePath(locale)}#casa`}>{t.house}</a>
    <a
      href={menuPath(locale)}
      aria-current={page === "menu" ? "page" : undefined}
    >
      {t.menu}
    </a>
    <a href={`${homePath(locale)}#contacte`}>{t.contact}</a>
  </nav>
  <div class="header-actions mono">
    <details class="language-picker header-disclosure">
      <summary aria-label={`${locale.toUpperCase()} · ${t.languages}: ${languageNames[locale]}`}>
        {locale.toUpperCase()}
        <svg
          class="language-chevron"
          viewBox="0 0 12 12"
          fill="none"
          aria-hidden="true"
        >
          <path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.25" />
        </svg>
      </summary>
      <nav class="language-options" aria-label={t.languages}>
        {locales.map((lang) => (
          <a
            href={pagePath(page, lang)}
            lang={lang}
            hreflang={lang}
            aria-label={`${lang.toUpperCase()} · ${languageNames[lang]}`}
            aria-current={lang === locale ? "page" : undefined}
          >
            <span class="language-name">{languageNames[lang]}</span>
            <span class="language-code" aria-hidden="true">
              {lang.toUpperCase()}
            </span>
          </a>
        ))}
      </nav>
    </details>
    <a class="header-reserve" href={reservationUrl(locale)}>
      {t.book} <span aria-hidden="true">↗</span>
    </a>
    <details class="mobile-navigation header-disclosure">
      <summary>
        {t.navigationToggle}{" "}
        <span class="menu-sign" aria-hidden="true">
          +
        </span>
      </summary>
      <nav class="header-panel mobile-links" aria-label={t.navigation}>
        <a href={`${homePath(locale)}#casa`}>{t.house}</a>
        <a
          href={menuPath(locale)}
          aria-current={page === "menu" ? "page" : undefined}
        >
          {t.menu}
        </a>
        <a href={`${homePath(locale)}#contacte`}>{t.contact}</a>
        <a class="mobile-reserve" href={reservationUrl(locale)}>
          {t.reserve} <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const disclosures = [
    ...header.querySelectorAll<HTMLDetailsElement>(".header-disclosure"),
  ];
  const languagePicker =
    header.querySelector<HTMLDetailsElement>(".language-picker")!;
  const hoverPointer = matchMedia("(hover: hover) and (pointer: fine)");
  const motionPreference = matchMedia("(prefers-reduced-motion: reduce)");
  let hoverCloseTimer: ReturnType<typeof setTimeout>;
  let hoverExit: Animation | undefined;
  const openDisclosure = (disclosure: HTMLDetailsElement) => {
    for (const other of disclosures)
      if (other !== disclosure) other.open = false;
    disclosure.open = true;
  };
  languagePicker.addEventListener("pointerenter", (event) => {
    if (!hoverPointer.matches || event.pointerType === "touch") return;
    clearTimeout(hoverCloseTimer);
    hoverExit?.cancel();
    openDisclosure(languagePicker);
  });
  languagePicker.addEventListener("pointerleave", () => {
    if (!hoverPointer.matches) return;
    hoverCloseTimer = setTimeout(async () => {
      if (
        languagePicker.contains(document.activeElement) ||
        !languagePicker.open
      )
        return;
      if (motionPreference.matches) {
        languagePicker.open = false;
        return;
      }
      hoverExit = languagePicker.querySelector("nav")!.animate(
        [
          { opacity: 1, transform: "translateY(0)" },
          { opacity: 0, transform: "translateY(-4px)" },
        ],
        { duration: 140, easing: "ease-in", fill: "forwards" },
      );
      try {
        await hoverExit.finished;
        languagePicker.open = false;
        hoverExit.cancel();
      } catch {
        // Re-entering or focusing the list interrupts its exit.
      }
    }, 160);
  });
  languagePicker.addEventListener("focusin", () => {
    clearTimeout(hoverCloseTimer);
    hoverExit?.cancel();
  });
  const updateHeader = () =>
    header.classList.toggle("scrolled", window.scrollY > 16);
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  for (const disclosure of disclosures) {
    const summary = disclosure.querySelector("summary")!;
    summary.setAttribute("aria-expanded", String(disclosure.open));
    disclosure.addEventListener("toggle", () => {
      summary.setAttribute("aria-expanded", String(disclosure.open));
      if (!disclosure.open && disclosure === languagePicker)
        hoverExit?.cancel();
      if (disclosure.open) {
        for (const other of disclosures)
          if (other !== disclosure) other.open = false;
      }
    });
    disclosure.addEventListener("focusout", (event) => {
      if (!disclosure.contains(event.relatedTarget as Node | null))
        disclosure.open = false;
    });
    disclosure.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        disclosure.open = false;
      });
    });
  }
  document.addEventListener("pointerdown", (event) => {
    for (const disclosure of disclosures) {
      if (!disclosure.contains(event.target as Node)) disclosure.open = false;
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const disclosure of disclosures) {
      if (disclosure.open) {
        disclosure.open = false;
        disclosure.querySelector("summary")?.focus();
      }
    }
  });
  matchMedia("(max-width: 700px)").addEventListener("change", () => {
    clearTimeout(hoverCloseTimer);
    for (const disclosure of disclosures) disclosure.open = false;
  });
</script>
