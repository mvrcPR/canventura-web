---
import Layout from "../layouts/Layout.astro";
import ReserveButton from "./ReserveButton.astro";
import PhotoGallery from "./PhotoGallery.astro";
import {
  copy,
  houseTour,
  menuPath,
  reservationUrl,
  restaurant,
  type Locale,
} from "../content/site";
import { photos } from "../content/photos";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const kitchenPhotos = [
  { image: photos.grill, alt: t.photoGrill },
  { image: photos.dish, alt: t.photoDish },
  { image: photos.room, alt: t.photoRoom },
  { image: photos.hands, alt: t.photoHands },
  { image: photos.season, alt: t.photoDish },
];
---

<Layout locale={locale}>
  <main id="main">
    <section class="hero" data-hero aria-labelledby="hero-title">
      <div class="hero-photo">
        <img
          src={photos.chef.src}
          width={photos.chef.width}
          height={photos.chef.height}
          alt={t.photoChef}
          fetchpriority="high"
          loading="eager"
        />
      </div>
      <div class="hero-frame">
        <div class="hero-copy">
          <h1 id="hero-title">Can Ventura</h1>
          <div class="hero-details mono">
            <p>Plaça Major nº1, Llívia, Girona</p>
            <a href={`tel:${restaurant.phone}`}>{restaurant.phoneLabel}</a>
            <a href={`mailto:${restaurant.email}`}>{restaurant.email}</a>
          </div>
        </div>
        <ReserveButton locale={locale} class="hero-reserve" />
      </div>
    </section>
    <section
      class="house-section section-space"
      id="casa"
      aria-labelledby="house-title"
    >
      <div class="house-composition" data-reveal>
        <div class="house-note">
          <a class="house-entry-copy" href={houseTour.url} data-open-tour>
            <h2 id="house-title">{t.houseTitle}</h2>
            <div class="house-invitation">
              <p class="mono">{t.houseInvitation}</p>
              <div class="house-arrow" aria-hidden="true">
                <svg class="hand-arrow" viewBox="0 0 550 360" fill="none">
                  <path
                    d="M550 0C520 103 423 213 306 258C207 296 97 277 29 229M29 229L39 264M29 229L66 218"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="butt"
                    stroke-linejoin="round"
                  />
                </svg>
                <span class="house-tip-marker"></span>
              </div>
            </div>
          </a>
        </div>
        <a
          class="house-door"
          href={houseTour.url}
          data-open-tour
          aria-label={t.openHouse}
        >
          <img
            src={photos.facade.src}
            width={photos.facade.width}
            height={photos.facade.height}
            alt={t.photoFacade}
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
      <dialog
        id="house-tour-dialog"
        class="tour-dialog"
        aria-labelledby="house-tour-title"
      >
        <div class="house-tour">
          <div class="tour-heading mono">
            <h2 id="house-tour-title">{t.houseGallery}</h2>
            <div class="tour-actions">
              <a
                class="tour-external"
                href={houseTour.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t.openTourExternal}
              >
                Google Maps <span aria-hidden="true">↗</span>
              </a>
              <button type="button" class="tour-close" data-close-tour>
                {t.close} <span aria-hidden="true">×</span>
              </button>
            </div>
          </div>
          <div class="tour-viewer">
            <p class="tour-loading mono" role="status">
              {t.tourLoading}
            </p>
            <iframe
              title={t.houseGallery}
              data-src={`${houseTour.embedUrl}&hl=${locale}`}
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
        </div>
      </dialog>
    </section>
    <section
      class="kitchen-section section-space"
      id="cuina"
      aria-labelledby="kitchen-title"
    >
      <div class="section-heading mono">
        <span>02 / {t.kitchen}</span>
        <span>{t.galleryLabel}</span>
      </div>
      <div class="section-intro" data-reveal>
        <h2 class="display-heading" id="kitchen-title">
          {t.kitchenTitle}
        </h2>
        <p>{t.kitchenText}</p>
      </div>
      <PhotoGallery
        id="kitchen-gallery"
        locale={locale}
        images={kitchenPhotos}
        label={t.galleryLabel}
        start={1}
      />
    </section>
    <section
      class="menu-section section-space"
      id="carta"
      aria-labelledby="menu-title"
    >
      <div class="section-heading mono">
        <span>03 / {t.menu}</span>
      </div>
      <div class="menu-composition" data-reveal>
        <div class="menu-copy">
          <h2 class="display-heading" id="menu-title">
            {t.menuTitle}
          </h2>
          <p>{t.menuText}</p>
          <a class="text-link mono" href={menuPath(locale)}>
            {t.viewMenu}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <img
          src={photos.hands.src}
          width={photos.hands.width}
          height={photos.hands.height}
          alt={t.photoHands}
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>
    <section
      class="family-section section-space"
      id="familia"
      aria-labelledby="family-title"
    >
      <div class="section-heading mono">
        <span>04 / {t.family}</span>
        <span>1977 — {new Date().getFullYear()}</span>
      </div>
      <div class="family-composition" data-reveal>
        <img
          src={photos.kitchen.src}
          width={photos.kitchen.width}
          height={photos.kitchen.height}
          alt={t.photoHands}
          loading="lazy"
          decoding="async"
        />
        <div>
          <h2 class="display-heading" id="family-title">
            {t.familyTitle}
          </h2>
          <p>{t.familyText}</p>
          <p class="muted">{t.familySecond}</p>
        </div>
      </div>
    </section>
    <section
      class="contact-section section-space"
      id="contacte"
      aria-labelledby="contact-title"
    >
      <div class="section-heading mono">
        <span>05 / {t.contact}</span>
        <span>{t.location}</span>
      </div>
      <h2 class="display-heading" id="contact-title" data-reveal>
        {t.contactTitle}
      </h2>
      <div class="contact-grid">
        <div>
          <h3 class="mono">{t.findUs}</h3>
          <address>
            Plaça Major, 1<br />
            17527 Llívia, Girona
          </address>
          <a class="text-link mono" href={restaurant.directions}>
            {t.directions} ↗
          </a>
        </div>
        <div>
          <h3 class="mono">{t.callUs}</h3>
          <a class="contact-phone" href={`tel:${restaurant.phone}`}>
            {restaurant.phoneLabel}
          </a>
          <a class="contact-email" href={`mailto:${restaurant.email}`}>
            {restaurant.email}
          </a>
        </div>
        <div>
          <h3 class="mono">{t.hours}</h3>
          <p>{t.hoursText}</p>
          <a class="text-link mono" href={reservationUrl(locale)}>
            {t.reserve} ↗
          </a>
        </div>
      </div>
    </section>
  </main>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>(".tour-dialog")!;
    const viewer = dialog.querySelector<HTMLElement>(".tour-viewer")!;
    const frame = viewer.querySelector<HTMLIFrameElement>("iframe")!;
    const loading = viewer.querySelector<HTMLElement>(".tour-loading")!;
    const triggers =
      document.querySelectorAll<HTMLAnchorElement>("[data-open-tour]");
    let activeTrigger = triggers[0];
    const composition =
      document.querySelector<HTMLElement>(".house-composition")!;
    const touchPointer = matchMedia("(hover: none), (pointer: coarse)");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const door = composition.querySelector<HTMLElement>(".house-door")!;
    let entryAnimation: Animation | undefined;
    let opening = false;
    let closing = false;
    let hintTimer: ReturnType<typeof setTimeout> | undefined;
    let hasOpenedTour = false;
    const clearHint = () => {
      clearTimeout(hintTimer);
      composition.classList.remove("tour-hint-visible");
    };
    const hintObserver = new IntersectionObserver(
      ([entry]) => {
        clearHint();
        if (
          entry.intersectionRatio >= 0.3 &&
          touchPointer.matches &&
          !hasOpenedTour
        ) {
          hintTimer = setTimeout(
            () => composition.classList.add("tour-hint-visible"),
            2000,
          );
        }
      },
      { threshold: 0.3, rootMargin: "-110px 0px -90px 0px" },
    );
    hintObserver.observe(composition);
    const closeButton =
      dialog.querySelector<HTMLButtonElement>("[data-close-tour]")!;
    frame.addEventListener("load", () => {
      if (!frame.hasAttribute("src")) return;
      viewer.classList.add("is-loaded");
      viewer.removeAttribute("aria-busy");
      loading.hidden = true;
    });
    const close = async () => {
      if (closing || !dialog.open) return;
      closing = true;
      dialog.classList.add("is-closing");
      if (!reducedMotion.matches) {
        const currentStyle = getComputedStyle(dialog);
        await dialog.animate(
          [
            { opacity: currentStyle.opacity, transform: currentStyle.transform },
            { opacity: 0, transform: "scale(0.995)" },
          ],
          { duration: 320, easing: "ease-in-out", fill: "forwards" },
        ).finished;
      }
      dialog.close();
    };
    dialog.addEventListener("close", () => {
      dialog.getAnimations().forEach((animation) => animation.cancel());
      dialog.classList.remove("is-closing");
      entryAnimation?.cancel();
      closing = false;
      frame.removeAttribute("src");
      viewer.classList.remove("is-loaded");
      viewer.removeAttribute("aria-busy");
      loading.hidden = false;
      document.body.classList.remove("dialog-open");
      activeTrigger.focus({ preventScroll: true });
    });
    triggers.forEach((trigger) => {
      trigger.setAttribute("aria-haspopup", "dialog");
      trigger.setAttribute("aria-controls", dialog.id);
      trigger.addEventListener("click", async (event) => {
        event.preventDefault();
        if (opening || closing || dialog.open) return;
        opening = true;
        activeTrigger = trigger;
        hasOpenedTour = true;
        clearHint();
        hintObserver.disconnect();
        document.body.classList.add("dialog-open");
        viewer.setAttribute("aria-busy", "true");
        frame.src = frame.dataset.src!;
        if (!reducedMotion.matches) {
          entryAnimation = door.animate(
            [
              { transform: getComputedStyle(door).transform },
              { transform: "scale(1.085)" },
            ],
            {
              duration: 650,
              easing: "cubic-bezier(0.45, 0, 0.2, 1)",
              fill: "forwards",
            },
          );
          await entryAnimation.finished;
        }
        dialog.showModal();
        opening = false;
        closeButton.focus();
      });
    });
    closeButton.addEventListener("click", close);
    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      close();
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });
  </script>
</Layout>
