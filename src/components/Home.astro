---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import ReserveButton from "./ReserveButton.astro";
import PhotoGallery from "./PhotoGallery.astro";
import {
  copy,
  houseTour,
  menuPath,
  restaurant,
  type Locale,
} from "../content/site";
import { kitchenPhotography, photos } from "../content/photos";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const kitchenPhotos = kitchenPhotography.map(
  ({ image, subject, objectPosition }) => ({
    image,
    objectPosition,
    alt: t.foodPhotos[subject],
  }),
);
---

<Layout locale={locale}>
  <main id="main">
    <section class="hero" data-hero aria-labelledby="hero-title">
      <div class="hero-photo">
        <Image
          src={photos.chef}
          widths={[480, 768, 1024, 1280, 1488]}
          sizes="(max-width: 700px) max(100vw, calc(80svh - 112px)), 64vw"
          format="webp"
          quality={85}
          alt={t.photoChef}
          fetchpriority="high"
          loading="eager"
        />
      </div>
      <div class="hero-frame">
        <div class="hero-copy">
          <h1 id="hero-title">Can Ventura</h1>
          <div class="hero-details mono">
            <p>Plaça Major nº1, Llívia, Girona</p>
            <a href={`tel:${restaurant.phone}`}>{restaurant.phoneLabel}</a>
          </div>
        </div>
        <ReserveButton locale={locale} class="hero-reserve" />
      </div>
    </section>
    <section
      class="family-section section-space"
      id="familia"
      aria-labelledby="family-title"
    >
      <div class="family-composition">
        <h2 class="display-heading" id="family-title" data-reveal>
          {t.familyTitle}
        </h2>
        <figure class="family-archive" data-reveal>
          <Image
            src={photos.founders}
            widths={[240, 480, 768, 1024]}
            sizes="(max-width: 700px) 70vw, 32vw"
            format="webp"
            quality={85}
            alt={t.photoFounders}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <span class="mono">{t.familyFoundersCaption}</span>
            <p class="family-story">{t.familyText}</p>
          </figcaption>
        </figure>
        <figure class="family-house" data-reveal>
          <Image
            src={photos.house}
            width={500}
            widths={[160, 320, 500]}
            sizes="(max-width: 700px) 38vw, 250px"
            format="webp"
            quality={85}
            alt={{ ca: "La façana de Can Ventura l’any 1983", es: "La fachada de Can Ventura en 1983", fr: "La façade de Can Ventura en 1983", en: "The façade of Can Ventura in 1983" }[locale]}
            loading="lazy"
            decoding="async"
          />
          <figcaption class="family-caption mono">
            <span class="family-photo-credit">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                role="img"
                aria-label={{ ca: "Fotografia", es: "Fotografía", fr: "Photographie", en: "Photograph" }[locale]}
              >
                <path d="M4 6.5h4l1.5-3h5l1.5 3h4a1.5 1.5 0 0 1 1.5 1.5v11a1.5 1.5 0 0 1-1.5 1.5H4A1.5 1.5 0 0 1 2.5 19V8A1.5 1.5 0 0 1 4 6.5Z" />
                <circle cx="12" cy="13" r="4" />
              </svg>
              <a
                href="https://calaix.gencat.cat/handle/10687/94759"
                title="Albert Aymà Aubeyzon · Generalitat de Catalunya · Calaix · 10/04/2015"
              >
                Albert Aymà · 1983
              </a>
            </span>
          </figcaption>
        </figure>
        <figure class="family-team" data-reveal>
          <div class="family-team-photo">
            <Image
              src={photos.family}
              widths={[320, 640, 960, 1280]}
              sizes="(max-width: 700px) calc(100vw - 48px), (min-width: 1440px) 830px, 58vw"
              format="webp"
              quality={85}
              alt={t.photoFamily}
              loading="lazy"
              decoding="async"
            />
            <span class="family-photo-credit mono">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                role="img"
                aria-label={{ ca: "Fotografia", es: "Fotografía", fr: "Photographie", en: "Photograph" }[locale]}
              >
                <path d="M4 6.5h4l1.5-3h5l1.5 3h4a1.5 1.5 0 0 1 1.5 1.5v11a1.5 1.5 0 0 1-1.5 1.5H4A1.5 1.5 0 0 1 2.5 19V8A1.5 1.5 0 0 1 4 6.5Z" />
                <circle cx="12" cy="13" r="4" />
              </svg>
              Pere Virgili
            </span>
          </div>
          <figcaption class="family-caption mono">
            <span>{t.familyTeamCaption}</span>
          </figcaption>
        </figure>
        <p class="family-story family-current" data-reveal>
          {t.familySecond}
        </p>
      </div>
    </section>
    <section
      class="kitchen-section section-space"
      id="cuina"
      aria-labelledby="kitchen-title"
    >
      <div class="section-intro" data-reveal>
        <h2 class="display-heading" id="kitchen-title">
          {t.kitchenTitle}
        </h2>
        <div class="section-intro-copy" id="carta">
          <p>{t.kitchenText}</p>
          <a class="text-link kitchen-menu-link mono" href={menuPath(locale)}>
            {t.viewMenu}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <PhotoGallery
        id="kitchen-gallery"
        locale={locale}
        images={kitchenPhotos}
        label={t.galleryLabel}
        start={2}
        loop
      />
    </section>
    <section
      class="house-section section-space"
      id="casa"
      aria-labelledby="house-title"
    >
      <div class="house-composition" data-reveal>
        <div class="house-note">
          <a class="house-entry-copy" href={houseTour.url} data-open-tour>
            <h2 id="house-title">{t.houseTitle}</h2>
            <div class="house-invitation">
              <p class="mono">{t.houseInvitation}</p>
              <div class="house-arrow" aria-hidden="true">
                <svg
                  class="hand-arrow hand-arrow-desktop"
                  viewBox="0 0 550 360"
                  fill="none"
                >
                  <path
                    pathLength="1"
                    d="M550 0C520 103 423 213 306 258C207 296 97 277 29 229M29 229L39 264M29 229L66 218"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="butt"
                    stroke-linejoin="round"
                  />
                </svg>
                <svg
                  class="hand-arrow hand-arrow-mobile"
                  viewBox="0 0 300 300"
                  preserveAspectRatio="none"
                  fill="none"
                >
                  <path
                    d="M280 0C286 96 206 156 135 176C95 188 56 202 42 239M42 239L36 207M42 239L73 225"
                    pathLength="1"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="butt"
                    stroke-linejoin="round"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
                <span class="house-tip-marker"></span>
              </div>
            </div>
          </a>
        </div>
        <a
          class="house-door"
          href={houseTour.url}
          data-open-tour
          aria-label={t.openHouse}
        >
          <Image
            src={photos.facade}
            width={1280}
            widths={[320, 640, 960, 1280]}
            sizes="(max-width: 700px) 78vw, (min-width: 1800px) 520px, 42vw"
            format="webp"
            quality={85}
            alt={t.photoFacade}
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
      <dialog
        id="house-tour-dialog"
        class="tour-dialog"
        aria-labelledby="house-tour-title"
      >
        <div class="house-tour">
          <div class="tour-heading mono">
            <h2 id="house-tour-title">{t.houseGallery}</h2>
            <div class="tour-actions">
              <a
                class="tour-external"
                href={houseTour.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t.openTourExternal}
              >
                Google Maps <span aria-hidden="true">↗</span>
              </a>
              <button type="button" class="tour-close" data-close-tour>
                {t.close} <span aria-hidden="true">×</span>
              </button>
            </div>
          </div>
          <div class="tour-viewer">
            <p class="tour-loading mono" role="status">
              {t.tourLoading}
            </p>
            <iframe
              title={t.houseGallery}
              data-src={`${houseTour.embedUrl}&hl=${locale}`}
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
        </div>
      </dialog>
    </section>
  </main>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>(".tour-dialog")!;
    const viewer = dialog.querySelector<HTMLElement>(".tour-viewer")!;
    const frame = viewer.querySelector<HTMLIFrameElement>("iframe")!;
    const loading = viewer.querySelector<HTMLElement>(".tour-loading")!;
    const triggers =
      document.querySelectorAll<HTMLAnchorElement>("[data-open-tour]");
    let activeTrigger = triggers[0];
    const composition =
      document.querySelector<HTMLElement>(".house-composition")!;
    const touchPointer = matchMedia("(hover: none), (pointer: coarse)");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const door = composition.querySelector<HTMLElement>(".house-door")!;
    let entryAnimation: Animation | undefined;
    let opening = false;
    let closing = false;
    let hintTimer: ReturnType<typeof setTimeout> | undefined;
    let hasOpenedTour = false;
    const clearHint = () => {
      clearTimeout(hintTimer);
      composition.classList.remove("tour-hint-visible");
    };
    const hintObserver = new IntersectionObserver(
      ([entry]) => {
        clearHint();
        if (
          entry.intersectionRatio >= 0.3 &&
          touchPointer.matches &&
          !hasOpenedTour
        ) {
          hintTimer = setTimeout(
            () => composition.classList.add("tour-hint-visible"),
            2000,
          );
        }
      },
      { threshold: 0.3, rootMargin: "-110px 0px -90px 0px" },
    );
    hintObserver.observe(composition);
    const closeButton =
      dialog.querySelector<HTMLButtonElement>("[data-close-tour]")!;
    frame.addEventListener("load", () => {
      if (!frame.hasAttribute("src")) return;
      viewer.classList.add("is-loaded");
      viewer.removeAttribute("aria-busy");
      loading.hidden = true;
    });
    const close = async () => {
      if (closing || !dialog.open) return;
      closing = true;
      dialog.classList.add("is-closing");
      if (!reducedMotion.matches) {
        const currentStyle = getComputedStyle(dialog);
        await dialog.animate(
          [
            { opacity: currentStyle.opacity, transform: currentStyle.transform },
            { opacity: 0, transform: "scale(0.995)" },
          ],
          { duration: 320, easing: "ease-in-out", fill: "forwards" },
        ).finished;
      }
      dialog.close();
    };
    dialog.addEventListener("close", () => {
      dialog.getAnimations().forEach((animation) => animation.cancel());
      dialog.classList.remove("is-closing");
      entryAnimation?.cancel();
      closing = false;
      frame.removeAttribute("src");
      viewer.classList.remove("is-loaded");
      viewer.removeAttribute("aria-busy");
      loading.hidden = false;
      document.body.classList.remove("dialog-open");
      activeTrigger.focus({ preventScroll: true });
    });
    triggers.forEach((trigger) => {
      trigger.setAttribute("aria-haspopup", "dialog");
      trigger.setAttribute("aria-controls", dialog.id);
      trigger.addEventListener("click", async (event) => {
        event.preventDefault();
        if (opening || closing || dialog.open) return;
        opening = true;
        activeTrigger = trigger;
        hasOpenedTour = true;
        clearHint();
        hintObserver.disconnect();
        document.body.classList.add("dialog-open");
        viewer.setAttribute("aria-busy", "true");
        frame.src = frame.dataset.src!;
        if (!reducedMotion.matches) {
          entryAnimation = door.animate(
            [
              { transform: getComputedStyle(door).transform },
              { transform: "scale(1.085)" },
            ],
            {
              duration: 650,
              easing: "cubic-bezier(0.45, 0, 0.2, 1)",
              fill: "forwards",
            },
          );
          await entryAnimation.finished;
        }
        dialog.showModal();
        opening = false;
        closeButton.focus();
      });
    });
    closeButton.addEventListener("click", close);
    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      close();
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });
  </script>
</Layout>
