---
import Layout from "../layouts/Layout.astro";
import { menuPath, reservationUrl, restaurant, type Locale } from "../content/site";
import { parkingUrl, visitCopy } from "../content/visit";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = visitCopy[locale];
---

<Layout
  locale={locale}
  page="visit"
  title={t.seoTitle}
  description={t.description}
>
  <main class="visit-page" id="main" data-visit-page>
    <div class="visit-intro">
      <h1 class="visit-title" data-reveal>{t.heading}</h1>
      <p class="visit-subtitle" data-reveal>{t.intro}</p>
    </div>
    <div class="visit-topics">
      {t.topics.map(({ id, title, paragraphs }) => (
        <section class="visit-topic" aria-labelledby={`visit-${id}`} data-reveal>
          <h2 id={`visit-${id}`}>{title}</h2>
          <div class="visit-answer">
            {paragraphs.map((text) => <p>{text}</p>)}
            {id === "booking" && (
              <div class="visit-actions">
                <a class="visit-booking visit-link text-link mono" href={reservationUrl(locale)}>
                  {t.bookingLink} <span aria-hidden="true">↗</span>
                </a>
                <a class="visit-link text-link mono" href={`tel:${restaurant.phone}`}>
                  {locale === "fr" || locale === "en" ? "+34 " : ""}{restaurant.phoneLabel}
                </a>
              </div>
            )}
            {id === "location-hours" && (
              <a class="visit-hours visit-link text-link mono" href={restaurant.directions}>
                {t.hoursLink} <span aria-hidden="true">↗</span>
              </a>
            )}
            {(id === "menu" || id === "tasting-menu") && (
              <a class="visit-menu visit-link text-link mono" href={menuPath(locale)}>
                {t.menuLink} <span aria-hidden="true">↗</span>
              </a>
            )}
            {id === "parking" && (
              <a class="visit-parking visit-link text-link mono" href={parkingUrl}>
                {t.parkingLink} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </section>
      ))}
    </div>
    <section class="visit-contact" aria-labelledby="visit-contact-title" data-reveal>
      <h2 id="visit-contact-title">{t.contact}</h2>
      <div class="visit-direct">
        <a class="visit-phone" href={`tel:${restaurant.phone}`}>
          {restaurant.phoneLabel}
        </a>
        <a class="visit-email" href={`mailto:${restaurant.email}`}>
          {restaurant.email}
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .visit-page {
    padding: 128px var(--gutter) 64px;
  }
  .visit-topic {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(48px, 8vw, 140px);
  }
  .visit-intro {
    margin: clamp(24px, 3vw, 44px) 0 clamp(52px, 5vw, 80px);
    text-align: left;
  }
  .visit-title {
    max-width: 1150px;
    margin: 0;
    font-size: clamp(52px, 8.3vw, 125px);
    line-height: 0.98;
    letter-spacing: -0.06em;
    text-wrap: balance;
    white-space: pre-line;
  }
  .visit-subtitle {
    max-width: 40ch;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.5;
    text-wrap: balance;
  }
  .visit-contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    column-gap: clamp(48px, 8vw, 140px);
    padding: 40px 0 24px;
    border-top: 1px solid var(--line);
  }
  .visit-contact a {
    display: flex;
    align-items: center;
    width: fit-content;
    min-height: 44px;
  }
  .visit-phone {
    font-size: clamp(24px, 2.1vw, 32px);
    letter-spacing: -0.03em;
    line-height: 1.3;
  }
  .visit-email {
    color: var(--muted);
    font-size: 15px;
    overflow-wrap: anywhere;
  }
  .visit-topic {
    padding: 36px 0 52px;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .visit-topic h2,
  .visit-contact h2 {
    max-width: 12em;
    font-size: clamp(30px, 3vw, 46px);
    line-height: 1.18;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .visit-answer {
    padding-top: 3px;
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.65;
  }
  .visit-answer p + p {
    margin-top: 20px;
  }
  .visit-link {
    min-height: 44px;
    margin-top: 16px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .visit-actions {
    display: flex;
    flex-wrap: wrap;
    column-gap: 28px;
  }
  @media (max-width: 700px) {
    .visit-page {
      padding-top: 108px;
      padding-bottom: 24px;
    }
    .visit-topic {
      grid-template-columns: minmax(0, 1fr);
    }
    .visit-intro {
      margin: 28px 0 68px;
    }
    .visit-title {
      font-size: clamp(46px, 11.4vw, 70px);
    }
    .visit-subtitle {
      margin-top: 22px;
      max-width: 28ch;
    }
    .visit-contact {
      grid-template-columns: minmax(0, 1fr);
      padding: 28px 0 16px;
      row-gap: 12px;
    }
    .visit-topic {
      padding: 28px 0 36px;
      row-gap: 18px;
    }
    .visit-topic h2,
    .visit-contact h2 {
      font-size: 30px;
    }
    .visit-answer {
      padding-top: 0;
      font-size: 17px;
    }
    .visit-answer p + p {
      margin-top: 16px;
    }
  }
</style>
