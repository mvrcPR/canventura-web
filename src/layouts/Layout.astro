---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ReserveButton from "../components/ReserveButton.astro";
import restaurantImage from "../assets/photography/optimized/restaurant-can-ventura-llivia.jpg";
import socialImage from "../assets/photography/optimized/entrada-can-ventura-social.jpg";
import {
  copy,
  locales,
  menuPath,
  pagePath,
  restaurant,
  siteUrl,
  type Locale,
  type Page,
} from "../content/site";
interface Props {
  locale: Locale;
  page?: Page;
  title?: string;
  description?: string;
}
const {
  locale,
  page = "home",
  title = copy[locale].title,
  description = copy[locale].description,
} = Astro.props;
const path = pagePath(page, locale);
const canonicalUrl = `${siteUrl}${path}`;
const socialImageUrl = `${siteUrl}${socialImage.src}`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Restaurant",
      "@id": `${siteUrl}/#restaurant`,
      name: restaurant.name,
      url: siteUrl,
      image: `${siteUrl}${restaurantImage.src}`,
      telephone: restaurant.phone,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Plaça Major, 1",
        addressLocality: "Llívia",
        postalCode: "17527",
        addressRegion: "Girona",
        addressCountry: "ES",
      },
      hasMenu: `${siteUrl}${menuPath(locale)}`,
      sameAs: [restaurant.instagram],
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: locale,
      about: { "@id": `${siteUrl}/#restaurant` },
      ...(page === "home" && {
        primaryImageOfPage: {
          "@type": "ImageObject",
          url: socialImageUrl,
          contentUrl: socialImageUrl,
          width: socialImage.width,
          height: socialImage.height,
          caption: copy[locale].photoFacade,
        },
      }),
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/favicon-192.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/brand/favicon.svg" />
    <link rel="canonical" href={`${siteUrl}${path}`} />
    {locales.map((lang) => (
      <link
        rel="alternate"
        hreflang={lang}
        href={`${siteUrl}${pagePath(page, lang)}`}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${siteUrl}${pagePath(page, "ca")}`}
    />
    <link
      rel="preload"
      href="/fonts/inter-regular-ac6e61d240.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-regular-47875c70ce.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${siteUrl}${path}`} />
    <meta property="og:site_name" content="Can Ventura" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={socialImage.width} />
    <meta property="og:image:height" content={socialImage.height} />
    <meta property="og:image:alt" content={copy[locale].photoFacade} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={copy[locale].photoFacade} />
    <meta
      property="og:locale"
      content={{ ca: "ca_ES", es: "es_ES", fr: "fr_FR", en: "en_GB" }[locale]}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy[locale].skip}
    </a>
    <Header locale={locale} page={page} />
    <slot />
    <Footer locale={locale} showContact={page === "home"} />
    <ReserveButton
      locale={locale}
      class={`floating-reserve${page !== "home" ? " visible" : ""}`}
    />
    <script>
      const heroReserve = document.querySelector(".hero-reserve");
      const floating = document.querySelector(".floating-reserve");
      const fixedHeader = document.querySelector<HTMLElement>(".site-header");
      if (floating) {
        const setReservationVisibility = (visible: boolean) => {
          fixedHeader?.classList.toggle("reservation-visible", visible);
          floating.classList.toggle("visible", visible);
          floating.toggleAttribute("inert", !visible);
        };
        if (heroReserve) {
          const updateReservation = () =>
            setReservationVisibility(
              heroReserve.getBoundingClientRect().bottom <=
                (fixedHeader?.offsetHeight ?? 0),
            );
          updateReservation();
          window.addEventListener("scroll", updateReservation, {
            passive: true,
          });
          window.addEventListener("resize", updateReservation);
        } else setReservationVisibility(true);
      }
      const motionPreference = matchMedia("(prefers-reduced-motion: reduce)");
      if ("IntersectionObserver" in window && !motionPreference.matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries)
              if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                observer.unobserve(entry.target);
              }
          },
          { threshold: 0.08, rootMargin: "0px 0px -32px 0px" },
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => {
          el.classList.add("will-reveal");
          observer.observe(el);
        });
        document.addEventListener("focusin", (event) => {
          const target = (event.target as Element).closest("[data-reveal]");
          if (target) {
            target.classList.add("in-view");
            observer.unobserve(target);
          }
        });
        motionPreference.addEventListener("change", () => {
          if (!motionPreference.matches) return;
          observer.disconnect();
          document
            .querySelectorAll("[data-reveal]")
            .forEach((el) => el.classList.add("in-view"));
        });
      }
    </script>
  </body>
</html>
